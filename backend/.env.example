# ── LLM Configuration ─────────────────────────────────────────────
# Free API key: https://console.groq.com (any OpenAI-compatible provider works)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ── Authentication (Clerk) ─────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ── Database (Supabase) — required, backend exits if missing ──────
# https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Optional tuning (defaults shown) ──────────────────────────────
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=180.0
# RAG_TOP_K=7
# RAG_MAX_PROMPT_CHARS=16000
# MAX_FILE_SIZE=10485760
# MAX_BATCH_FILES=50
# MAX_RESUME_CHARS=6000
# LOG_LEVEL=INFO
